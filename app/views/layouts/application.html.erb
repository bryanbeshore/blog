<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for(:title) || "Bryan Beshore" %></title>
    <meta name="description" content="<%= content_for(:description) || "CTO, engineer, and startup builder." %>">

    <meta property="og:title" content="<%= content_for(:title) || "Bryan Beshore" %>">
    <meta property="og:description" content="<%= content_for(:description) || "CTO, engineer, and startup builder." %>">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script defer src="https://cloud.umami.is/script.js" data-website-id="83517119-55ce-44ea-8a64-5b92d5c020f8"></script>
  </head>

  <body class="h-full bg-white text-gray-900 antialiased">
    <div class="min-h-full">
      <nav class="border-b border-gray-100">
        <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
          <div class="flex h-16 justify-between items-center">
            <%= link_to "Bryan Beshore", root_path, class: "text-sm font-medium text-gray-900 hover:text-gray-600" %>
            <div class="flex space-x-8">
              <%= link_to "Writings", writings_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
              <%= link_to "About", about_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
              <%= link_to "Twitter", "https://twitter.com/bryanbeshore", target: "_blank", rel: "noopener", class: "text-sm text-gray-500 hover:text-gray-900" %>
            </div>
          </div>
        </div>
      </nav>

      <main class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
        <%= yield %>
      </main>

      <footer class="border-t border-gray-100 mt-16">
        <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8">
          <p class="text-sm text-gray-400 text-center">
            &copy; <%= Date.current.year %> Bryan Beshore
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
